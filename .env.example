SERVER_PORT=:8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=crm_user
DB_PASSWORD=your_password
DB_NAME=acme_crm
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=10

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE_HOURS=24

# FinancialJuice 实时快讯 (Centrifugo WSS)
FJ_ENABLED=true
# 周期报告日志间隔 (秒)，只影响日志，快讯到达即推送前端
FJ_REPORT_INTERVAL=10
FJ_OUTPUT_PATH=financialjuice_news.jsonl
FJ_LOG_PATH=financialjuice_monitor.log
# 可选：Token 接口不可用时使用的备用 Token
FJ_TOKEN=
# 各国 CPI/PPI 数据缓存 (历史回补结果，12 小时内重启不再回补)
FJ_MACRO_PATH=financialjuice_macro.json
# 经济日历 (CPI/PPI 发布日程) 刷新间隔 (小时)
FJ_MACRO_CALENDAR_HOURS=6
