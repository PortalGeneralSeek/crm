# Acme Pro Components & CRM Environment Variables Template
# Copy this file to .env or export into your environment

# Optional: Figma API Token for figma_reader.py token extractor
# Generate at: https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=

